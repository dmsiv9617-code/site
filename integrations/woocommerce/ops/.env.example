# Template values only. Separate protected files and volumes for staging/production.
WOODBASE_DOMAIN=woodbase.ru
WB_ENVIRONMENT=production
WB_STORAGE_BYTES=5368709120
# Generate DB_PASSWORD and DB_ROOT_PASSWORD into an ignored protected .env file.
DB_PASSWORD=
DB_ROOT_PASSWORD=
WOOCOMMERCE_PLUGIN_DIR=/srv/woodbase/vendor/woocommerce
WP_CLI_PHAR=/srv/woodbase/tools/wp-cli.phar
VITE_DIST_DIR=/srv/woodbase/releases/current/dist
TLS_DIR=/srv/woodbase/tls
# For staging only: use its own hostname, certificates, DB and file volumes.
STAGING_AUTH_FILE=/srv/woodbase/staging.htpasswd
