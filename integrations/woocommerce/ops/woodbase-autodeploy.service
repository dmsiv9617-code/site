[Unit]
Description=Build and publish WoodBase storefront from GitHub
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/woodbase-autodeploy.py
TimeoutStartSec=15min
UMask=0022
Nice=10
StandardOutput=journal
StandardError=journal
